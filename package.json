{
  "name": "ottoman-legacy",
  "version": "0.1.0",
  "description": "Ottoman: A Legacy Through Generations - Isometric 2D simulation game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test:logic": "esbuild src/dev/logicTest.ts --bundle --platform=node --format=esm --outfile=.tmp/logicTest.mjs --tsconfig=tsconfig.json && node .tmp/logicTest.mjs",
    "test:combat": "esbuild src/dev/combatTest.ts --bundle --platform=node --format=esm --outfile=.tmp/combatTest.mjs --tsconfig=tsconfig.json && node .tmp/combatTest.mjs",
    "test:historical": "esbuild src/dev/historicalTest.ts --bundle --platform=node --format=esm --outfile=.tmp/historicalTest.mjs --tsconfig=tsconfig.json && node .tmp/historicalTest.mjs",
    "test:chronology": "esbuild src/dev/chronologyTest.ts --bundle --platform=node --format=esm --outfile=.tmp/chronologyTest.mjs --tsconfig=tsconfig.json && node .tmp/chronologyTest.mjs",
    "test:character": "esbuild src/dev/characterCustomizationTest.ts --bundle --platform=node --format=esm --outfile=.tmp/characterCustomizationTest.mjs --tsconfig=tsconfig.json && node .tmp/characterCustomizationTest.mjs",
    "test:family": "esbuild src/dev/familyTest.ts --bundle --platform=node --format=esm --outfile=.tmp/familyTest.mjs --tsconfig=tsconfig.json && node .tmp/familyTest.mjs",
    "test:professions": "esbuild src/dev/professionTest.ts --bundle --platform=node --format=esm --outfile=.tmp/professionTest.mjs --tsconfig=tsconfig.json && node .tmp/professionTest.mjs",
    "test:political": "esbuild src/dev/politicalTest.ts --bundle --platform=node --format=esm --outfile=.tmp/politicalTest.mjs --tsconfig=tsconfig.json && node .tmp/politicalTest.mjs",
    "test:save-ui": "esbuild src/dev/saveUiTest.ts --bundle --platform=node --format=esm --outfile=.tmp/saveUiTest.mjs --tsconfig=tsconfig.json && node .tmp/saveUiTest.mjs",
    "test:dialogue": "esbuild src/dev/dialogueTest.ts --bundle --platform=node --format=esm --outfile=.tmp/dialogueTest.mjs --tsconfig=tsconfig.json && node .tmp/dialogueTest.mjs",
    "test:battle": "esbuild src/dev/battleTest.ts --bundle --platform=node --format=esm --outfile=.tmp/battleTest.mjs --tsconfig=tsconfig.json && node .tmp/battleTest.mjs",
    "test:quest": "esbuild src/dev/questTest.ts --bundle --platform=node --format=esm --outfile=.tmp/questTest.mjs --tsconfig=tsconfig.json && node .tmp/questTest.mjs",
    "test:tutorial": "esbuild src/dev/tutorialTest.ts --bundle --platform=node --format=esm --outfile=.tmp/tutorialTest.mjs --tsconfig=tsconfig.json && node .tmp/tutorialTest.mjs",
    "test:atmosphere": "esbuild src/dev/atmosphereTest.ts --bundle --platform=node --format=esm --outfile=.tmp/atmosphereTest.mjs --tsconfig=tsconfig.json && node .tmp/atmosphereTest.mjs",
    "test:audio": "esbuild src/dev/audioTest.ts --bundle --platform=node --format=esm --outfile=.tmp/audioTest.mjs --tsconfig=tsconfig.json && node .tmp/audioTest.mjs",
    "test:village": "esbuild src/dev/villageTest.ts --bundle --platform=node --format=esm --outfile=.tmp/villageTest.mjs --tsconfig=tsconfig.json && node .tmp/villageTest.mjs",
    "test:world": "esbuild src/dev/worldTest.ts --bundle --platform=node --format=esm --outfile=.tmp/worldTest.mjs --tsconfig=tsconfig.json && node .tmp/worldTest.mjs",
    "test:smoke": "npm run build && node scripts/browser-smoke.mjs",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android",
    "android:build": "npm run android:sync && cap build android",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "npm run typecheck && npm run test:logic && npm run test:character && npm run test:combat && npm run test:historical && npm run test:chronology && npm run test:family && npm run test:professions && npm run test:political && npm run test:save-ui && npm run test:dialogue && npm run test:battle && npm run test:quest && npm run test:tutorial && npm run test:atmosphere && npm run test:audio && npm run test:village && npm run test:world"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "esbuild": "^0.21.5",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.11"
  },
  "keywords": [
    "phaser",
    "isometric",
    "game",
    "ottoman",
    "typescript"
  ],
  "author": "",
  "license": "MIT"
}
